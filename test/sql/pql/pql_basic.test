# name: test/sql/pql/pql_basic.test
# description: Predictive Query Language: TRAIN, PREDICT, DROP MODEL
# group: [pql]

statement ok
CREATE TABLE users AS
  SELECT i AS id,
         TIMESTAMP '2023-01-01' + INTERVAL '1 day' * ((i * 7) % 300) AS ts,
         (i % 13) * 1.0 AS tenure
  FROM range(600) t(i);

statement ok
CREATE TABLE events AS
  SELECT row_number() OVER () AS id, u.id AS user_id,
         u.ts - INTERVAL '1 day' * (k * 10 + 1) AS ts,
         10.0 + k AS amount
  FROM users u, range(25) r(k)
  WHERE k < (u.id % 20);

statement ok
INSERT INTO events
  SELECT 900000 + u.id, u.id, u.ts + INTERVAL '1 day' * 10, 5.0
  FROM users u WHERE (u.id % 20) > 10;

# a forecast target separates cleanly on this generator
query I
SELECT CAST(test >= 0.95 AS INTEGER) FROM pql_exec('TRAIN MODEL churn PREDICT EXISTS(events) FOR users AT ts HORIZON 30 DAYS OPTIONS (epochs = 80, hidden = 32)');
----
1

query I
SELECT count(*) FROM pql_models();
----
1

# predictions come back for exactly the filtered entities
query I
SELECT count(*) FROM pql_exec('PREDICT EXISTS(events) FOR users WHERE id < 6 USING MODEL churn');
----
6

# and they rank the known positives above the known negatives
query I
SELECT CAST(avg(CASE WHEN (id::BIGINT % 20) > 10 THEN prediction END) >
            avg(CASE WHEN (id::BIGINT % 20) > 10 THEN NULL ELSE prediction END) AS INTEGER)
FROM pql_exec('PREDICT EXISTS(events) FOR users USING MODEL churn');
----
1

statement ok
DROP MODEL churn;

query I
SELECT count(*) FROM pql_models();
----
0

# a forecast without a horizon is rejected at parse time
statement error
TRAIN MODEL bad PREDICT COUNT(events) FOR users AT ts;
----
<REGEX>:.*HORIZON.*

# so is an aggregate that needs a column but was given none
statement error
TRAIN MODEL bad PREDICT SUM(events) FOR users AT ts HORIZON 5 DAYS;
----
<REGEX>:.*needs a column.*

# predicting an attribute with a horizon is a category error
statement error
TRAIN MODEL bad PREDICT users.tenure FOR users HORIZON 5 DAYS;
----
<REGEX>:.*meaningless.*

statement error
PREDICT EXISTS(events) FOR users USING MODEL nope;
----
<REGEX>:.*no model named.*

# ---------------------------------------------------------------------------
# Text columns on the entity are features.
# ---------------------------------------------------------------------------

# The plan decides the label outright; nothing numeric predicts it. A model that
# cannot read text can only return the mean, which is an MAE near the baseline.
statement ok
CREATE TABLE members AS
  SELECT i AS id,
         TIMESTAMP '2024-01-01' + INTERVAL '1 day' * (i % 400) AS joined,
         ['premium', 'basic', 'trial'][1 + (i % 3)] AS plan,
         0.5 AS filler
  FROM range(3000) t(i);

statement ok
CREATE TABLE visits AS
  SELECT row_number() OVER () AS id, m.id AS member_id,
         m.joined + INTERVAL '1 day' * (1 + (k % 25)) AS at
  FROM members m, range(20) r(k)
  WHERE k < CASE m.plan WHEN 'premium' THEN 18 WHEN 'basic' THEN 4 ELSE 0 END;

statement ok
TRAIN MODEL by_plan PREDICT COUNT(visits) FOR members AT joined HORIZON 30 DAYS
  OPTIONS (epochs = 60, hidden = 32);

# far below the persistence baseline, which this task makes about 7.3
query I
SELECT CAST(test < 0.5 AND test < baseline / 10 AS INTEGER)
FROM pql_exec('TRAIN MODEL by_plan2 PREDICT COUNT(visits) FOR members AT joined HORIZON 30 DAYS OPTIONS (epochs = 60, hidden = 32)');
----
1

# each plan gets its own answer, and they are the right ones. The group mean,
# not the extreme: other features vary within a plan and move any single row a
# little, which says nothing about whether the plan was read.
query TI
SELECT m.plan, CAST(round(avg(p.prediction)) AS INTEGER)
FROM pql_exec('PREDICT COUNT(visits) FOR members USING MODEL by_plan') p
JOIN members m ON m.id = p.id
GROUP BY m.plan ORDER BY m.plan;
----
basic	4
premium	18
trial	0

# A high-cardinality column is frequency-encoded rather than given a slot each,
# and a column that is nearly one value per row is skipped as an identifier.
statement ok
CREATE TABLE wide AS
  SELECT i AS id,
         TIMESTAMP '2024-01-01' + INTERVAL '1 day' * (i % 300) AS joined,
         'c' || (i % 500) AS city,
         'ref-' || i AS external_ref,
         (i % 7) * 1.0 AS score
  FROM range(4000) t(i);

statement ok
CREATE TABLE hits AS
  SELECT row_number() OVER () AS id, w.id AS wide_id,
         w.joined - INTERVAL '1 day' * (k + 1) AS at
  FROM wide w, range(6) r(k) WHERE k < (w.id % 6);

statement ok
TRAIN MODEL wide_m PREDICT COUNT(hits) FOR wide AT joined HORIZON 30 DAYS
  OPTIONS (epochs = 10, hidden = 16);

# 500 cities cost one frequency slot, not 500 one-hot slots, and the unique
# reference column contributes nothing at all
query I
SELECT CAST(features < 40 AS INTEGER) FROM pql_exec('SHOW MODELS') WHERE model = 'wide_m';
----
1

# NULL is a value the encoding can carry
statement ok
CREATE TABLE withnull AS
  SELECT i AS id, TIMESTAMP '2024-01-01' + INTERVAL '1 day' * (i % 300) AS joined,
         CASE WHEN i % 5 = 0 THEN NULL ELSE ['a', 'b'][1 + (i % 2)] END AS tier,
         (i % 3) * 1.0 AS score
  FROM range(1200) t(i);

statement ok
CREATE TABLE taps AS
  SELECT row_number() OVER () AS id, w.id AS withnull_id,
         w.joined - INTERVAL '1 day' * (k + 1) AS at
  FROM withnull w, range(5) r(k) WHERE k < (w.id % 5);

statement ok
TRAIN MODEL null_m PREDICT COUNT(taps) FOR withnull AT joined HORIZON 30 DAYS
  OPTIONS (epochs = 10, hidden = 16);

query I
SELECT CAST(count(*) = 1200 AND count(prediction) = 1200 AS INTEGER)
FROM pql_exec('PREDICT COUNT(taps) FOR withnull USING MODEL null_m');
----
1

# ---------------------------------------------------------------------------
# Where the anchor falls in the week, and how evenly events are spaced.
# ---------------------------------------------------------------------------

# Every member has the same four events behind them. The only thing that differs
# is which weekday their anchor lands on, and that decides what follows.
statement ok
CREATE TABLE seas AS
  SELECT i AS id, TIMESTAMP '2024-01-01' + INTERVAL '1 day' * (i % 280) AS joined, 0.5 AS filler
  FROM range(3000) t(i);

statement ok
CREATE TABLE seas_ev AS
  SELECT row_number() OVER () AS id, s.id AS seas_id,
         s.joined - INTERVAL '1 day' * (5 + k * 7) AS at
  FROM seas s, range(4) r(k);

statement ok
INSERT INTO seas_ev
  SELECT 5000000 + row_number() OVER (), s.id, s.joined + INTERVAL '1 day' * (1 + (k % 6))
  FROM seas s, range(9) r(k)
  WHERE k < CASE WHEN dayofweek(s.joined) IN (0, 6) THEN 1 ELSE 9 END;

statement ok
TRAIN MODEL seasonal PREDICT COUNT(seas_ev) FOR seas AT joined HORIZON 7 DAYS
  OPTIONS (epochs = 80, hidden = 64);

# weekend anchors predict about 1, weekday anchors about 9
query I
SELECT CAST(round(avg(CASE WHEN dayofweek(s.joined) IN (0, 6) THEN NULL ELSE p.prediction END))
          - round(avg(CASE WHEN dayofweek(s.joined) IN (0, 6) THEN p.prediction ELSE NULL END))
          >= 6 AS INTEGER)
FROM pql_exec('PREDICT COUNT(seas_ev) FOR seas USING MODEL seasonal') p
JOIN seas s ON s.id = p.id;
----
1

# L2 is accepted and does not change what a model can express
statement ok
TRAIN MODEL seasonal_l2 PREDICT COUNT(seas_ev) FOR seas AT joined HORIZON 7 DAYS
  OPTIONS (epochs = 40, hidden = 32, l2 = 0.01);

statement error
TRAIN MODEL bad_opt PREDICT COUNT(seas_ev) FOR seas AT joined HORIZON 7 DAYS
  OPTIONS (epochs = 10, nonsense = 1);
----
<REGEX>:.*unknown option.*

# ---------------------------------------------------------------------------
# A rare positive: AUROC alone flatters it, so precision-recall is reported too.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE rare_u AS
  SELECT i AS id, TIMESTAMP '2024-01-01' + INTERVAL '1 day' * (i % 300) AS ts,
         (i * 7919 % 1000) / 1000.0 AS score
  FROM range(20000) t(i);

statement ok
CREATE TABLE rare_e AS
  SELECT row_number() OVER () AS id, u.id AS rare_u_id,
         u.ts - INTERVAL '1 day' * (k + 1) AS ts, 1.0 AS v
  FROM rare_u u, range(8) r(k) WHERE k < (u.id % 8);

statement ok
INSERT INTO rare_e
  SELECT 900000 + u.id, u.id, u.ts + INTERVAL '10 days', 1.0
  FROM rare_u u WHERE (u.id % 8) >= 6 AND (u.id * 13 % 100) < 12;

# pr_auc is reported, sits above the positive rate the baseline column carries,
# and stays below the AUROC that would have been the only number on offer
query I
SELECT CAST(pr_auc > baseline * 3 AND pr_auc < test AND baseline < 0.1 AS INTEGER)
FROM pql_exec('TRAIN MODEL rare PREDICT EXISTS(rare_e) FOR rare_u AT ts HORIZON 30 DAYS OPTIONS (epochs = 30)');
----
1

# a regression target has no precision-recall curve, and says so
query I
SELECT CAST(pr_auc IS NULL AND baseline IS NOT NULL AS INTEGER)
FROM pql_exec('TRAIN MODEL cnt PREDICT COUNT(rare_e) FOR rare_u AT ts HORIZON 30 DAYS OPTIONS (epochs = 10)');
----
1

# ---------------------------------------------------------------------------
# EXPLAIN MODEL: what the model actually leans on.
# ---------------------------------------------------------------------------

# plan decides the label outright and filler is a constant, so the ranking is
# known in advance
query I
SELECT CAST(feature LIKE 'plan%' AS INTEGER)
FROM pql_exec('EXPLAIN MODEL by_plan') ORDER BY importance DESC LIMIT 1;
----
1

# every feature group is listed, and the slots add up to the model's width
query I
SELECT CAST(sum(slots) = (SELECT features FROM pql_exec('SHOW MODELS') WHERE model = 'by_plan')
            AS INTEGER)
FROM pql_exec('EXPLAIN MODEL by_plan');
----
1

# a graph model has no dense feature vector to permute, and refuses rather than
# inventing numbers
statement ok
TRAIN MODEL sage_m PREDICT COUNT(visits) FOR members AT joined HORIZON 30 DAYS
  OPTIONS (epochs = 5, hidden = 16, arch = 'sage');

statement error
EXPLAIN MODEL sage_m;
----
<REGEX>:.*arch='sage'.*

statement error
EXPLAIN MODEL nonexistent;
----
<REGEX>:.*no model named.*
