# name: test/sql/pql_optimize.test
# description: OPTIMIZE and EXPLAIN OPTIMIZE: plans built from predictions
# group: [sql]

require pql

# Trucks with a repair history; a quarter are on the 'care' plan, which halves
# how often the risky ones come back for a repair.
statement ok
CREATE TABLE trucks AS
  SELECT i AS id, TIMESTAMP '2026-01-01' + INTERVAL '1 day' * ((i * 7) % 200) AS as_of,
         (i % 12) AS age, 50 + (i * 37 % 150) AS service_cost, (i % 3) + 1 AS crew,
         CASE WHEN i % 4 = 0 THEN 'care' ELSE 'basic' END AS plan
  FROM range(800) t(i);

statement ok
CREATE TABLE repairs AS
  SELECT row_number() OVER () AS id, t.id AS truck_id, t.as_of - INTERVAL '1 day' * (k * 9 + 1) AS at
  FROM trucks t, range(20) r(k) WHERE k < (t.id % 15);

statement ok
INSERT INTO repairs
  SELECT 900000 + t.id, t.id, t.as_of + INTERVAL '1 day' * 5
  FROM trucks t WHERE (t.id % 15) > 8 AND (t.plan = 'basic' OR t.id % 3 = 0);

statement ok
TRAIN MODEL breakdown PREDICT EXISTS(repairs) FOR trucks AT as_of HORIZON 30 DAYS OPTIONS (epochs = 60, hidden = 32);

# ---------------------------------------------------------------------------
# Which rows to act on
# ---------------------------------------------------------------------------

# the statement form and the table function agree
statement ok
OPTIMIZE trucks MAXIMIZE SUM(prediction * 4200 - service_cost) SUBJECT TO COUNT(*) <= 5 USING MODEL breakdown;

query I
SELECT count(*) FROM pql_exec('OPTIMIZE trucks MAXIMIZE SUM(prediction * 4200 - service_cost) SUBJECT TO COUNT(*) <= 5 USING MODEL breakdown');
----
5

# a plan row is keyed and anchored like a PREDICT row
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pql_exec('OPTIMIZE trucks MAXIMIZE SUM(prediction * 4200 - service_cost) SUBJECT TO COUNT(*) <= 5 USING MODEL breakdown'));
----
id	BIGINT
as_of	TIMESTAMP
prediction	DOUBLE
objective	DOUBLE

# five bays hold the five trucks worth most, by PREDICT's own numbers
query I
SELECT abs((SELECT sum(objective) FROM pql_exec('OPTIMIZE trucks MAXIMIZE SUM(prediction * 4200 - service_cost) SUBJECT TO COUNT(*) <= 5 USING MODEL breakdown'))
         - (SELECT sum(v) FROM (SELECT p.prediction * 4200 - t.service_cost AS v
                                FROM pql_exec('PREDICT EXISTS(repairs) FOR trucks USING MODEL breakdown') p
                                JOIN trucks t USING (id) ORDER BY v DESC LIMIT 5))) < 1e-6;
----
true

# with no limit, exactly the trucks worth servicing
query I
SELECT (SELECT count(*) FROM pql_exec('OPTIMIZE trucks MAXIMIZE SUM(prediction * 4200 - service_cost) USING MODEL breakdown'))
     = (SELECT count(*) FROM pql_exec('PREDICT EXISTS(repairs) FOR trucks USING MODEL breakdown') p
        JOIN trucks t USING (id) WHERE p.prediction * 4200 - t.service_cost > 0);
----
true

# a budget is kept, and with whole-number costs the plan is proven best
query I
SELECT sum(t.service_cost) <= 2000
FROM pql_exec('OPTIMIZE trucks MAXIMIZE SUM(prediction * 4200 - service_cost) SUBJECT TO SUM(service_cost) <= 2000 USING MODEL breakdown') p
JOIN trucks t USING (id);
----
true

query TII
SELECT measure, value IS NOT NULL, bound IS NOT NULL
FROM pql_exec('EXPLAIN OPTIMIZE trucks MAXIMIZE SUM(prediction * 4200 - service_cost) SUBJECT TO SUM(service_cost) <= 2000 USING MODEL breakdown');
----
objective	true	true
SUM(service_cost) <= 2000	true	true
rows	true	false
selected	true	false

query I
SELECT value = bound FROM pql_exec('EXPLAIN OPTIMIZE trucks MAXIMIZE SUM(prediction * 4200 - service_cost) SUBJECT TO SUM(service_cost) <= 2000 USING MODEL breakdown')
WHERE measure = 'objective';
----
true

# the plan EXPLAIN describes is the plan OPTIMIZE returns
query I
SELECT (SELECT round(sum(objective), 6) FROM pql_exec('OPTIMIZE trucks MAXIMIZE SUM(prediction * 4200 - service_cost) SUBJECT TO SUM(service_cost) <= 2000 USING MODEL breakdown'))
     = (SELECT round(value, 6) FROM pql_exec('EXPLAIN OPTIMIZE trucks MAXIMIZE SUM(prediction * 4200 - service_cost) SUBJECT TO SUM(service_cost) <= 2000 USING MODEL breakdown') WHERE measure = 'objective');
----
true

# a timestamp compared as a timestamp, in WHERE and inside a FILTERed limit
query III
SELECT count(*), bool_and(t.as_of >= TIMESTAMP '2026-03-01'), count(*) FILTER (WHERE t.as_of >= TIMESTAMP '2026-06-01') <= 2
FROM pql_exec('OPTIMIZE trucks WHERE as_of >= ''2026-03-01'' MAXIMIZE SUM(prediction) SUBJECT TO COUNT(*) <= 6 AND COUNT(*) FILTER (WHERE as_of >= ''2026-06-01'') <= 2 USING MODEL breakdown') p
JOIN trucks t USING (id);
----
6	true	true

query I
SELECT value = (SELECT count(*) FROM trucks WHERE as_of >= TIMESTAMP '2026-03-01')
FROM pql_exec('EXPLAIN OPTIMIZE trucks WHERE as_of >= ''2026-03-01'' MAXIMIZE SUM(prediction) USING MODEL breakdown')
WHERE measure = 'rows';
----
true

# MINIMIZE with a minimum: the cheapest three
query I
SELECT sum(objective) FROM pql_exec('OPTIMIZE trucks MINIMIZE SUM(service_cost) SUBJECT TO COUNT(*) >= 3 USING MODEL breakdown');
----
150

# a limit on the model's own answer: no truck below even odds
query I
SELECT bool_and(prediction >= 0.5) AND count(*) > 0
FROM pql_exec('OPTIMIZE trucks MAXIMIZE SUM(prediction * 4200 - service_cost) SUBJECT TO COUNT(*) FILTER (WHERE prediction < 0.5) <= 0 USING MODEL breakdown');
----
true

# ... but WHERE picks the rows before anything is predicted
statement error
OPTIMIZE trucks WHERE prediction > 0.5 MAXIMIZE SUM(prediction) USING MODEL breakdown;
----
<REGEX>:.*WHERE picks the rows before anything is predicted.*

# ---------------------------------------------------------------------------
# CHOOSE: a value per row
# ---------------------------------------------------------------------------

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pql_exec('OPTIMIZE trucks CHOOSE plan IN (''basic'', ''care'') MINIMIZE SUM(prediction * 4200 + CASE plan WHEN ''care'' THEN 300 ELSE 0 END) USING MODEL breakdown'));
----
id	BIGINT
as_of	TIMESTAMP
plan	VARCHAR
prediction	DOUBLE
objective	DOUBLE

# every truck gets a plan, and a cap on one choice holds
query II
SELECT count(*), count(*) FILTER (WHERE plan = 'care') <= 150
FROM pql_exec('OPTIMIZE trucks CHOOSE plan IN (''basic'', ''care'') MINIMIZE SUM(prediction * 4200 + CASE plan WHEN ''care'' THEN 300 ELSE 0 END) SUBJECT TO COUNT(*) FILTER (WHERE plan = ''care'') <= 150 USING MODEL breakdown');
----
800	true

# EXPLAIN reports the status quo and one row per choice
query T
SELECT string_agg(measure, ' | ' ORDER BY measure) FROM pql_exec('EXPLAIN OPTIMIZE trucks CHOOSE plan IN (''basic'', ''care'') MINIMIZE SUM(prediction * 4200 + CASE plan WHEN ''care'' THEN 300 ELSE 0 END) SUBJECT TO COUNT(*) FILTER (WHERE plan = ''care'') <= 150 USING MODEL breakdown');
----
COUNT(*) FILTER (WHERE plan = 'care') <= 150 | objective | plan = 'basic' | plan = 'care' | rows | status quo

# ... and the plan is predicted to do no worse than today
query I
SELECT max(value) FILTER (WHERE measure = 'objective') <= max(value) FILTER (WHERE measure = 'status quo')
FROM pql_exec('EXPLAIN OPTIMIZE trucks CHOOSE plan IN (''basic'', ''care'') MINIMIZE SUM(prediction * 4200 + CASE plan WHEN ''care'' THEN 300 ELSE 0 END) USING MODEL breakdown');
----
true

# a whole-number lever comes back as a whole number
query T
SELECT DISTINCT typeof(crew) FROM pql_exec('OPTIMIZE trucks CHOOSE crew IN (1, 3) MAXIMIZE SUM(prediction) USING MODEL breakdown');
----
BIGINT

# the lever is untouched afterwards
query II
SELECT count(*) FILTER (WHERE plan = 'care'), count(*) FROM trucks;
----
200	800

# ---------------------------------------------------------------------------
# What is refused, and where
# ---------------------------------------------------------------------------

statement error
OPTIMIZE trucks CHOOSE plan IN ('basic', 'gold') MAXIMIZE SUM(prediction) USING MODEL breakdown;
----
<REGEX>:.*never saw plan = 'gold' while training.*

statement error
OPTIMIZE trucks MAXIMIZE SUM(prediction) SUBJECT TO COUNT(*) >= 900 USING MODEL breakdown;
----
<REGEX>:.*no plan can meet COUNT\(\*\) >= 900: the most any plan reaches is 800.*

statement error
OPTIMIZE trucks MAXIMIZE SUM(prediction) SUBJECT TO COUNT(*) <= 2 AND COUNT(*) >= 3 USING MODEL breakdown;
----
<REGEX>:.*no plan meets all of these limits together.*

statement error
OPTIMIZE trucks MAXIMIZE SUM(prediction) SUBJECT TO COUNT(*) < 9 USING MODEL breakdown;
----
<REGEX>:.*written with <= or >=.*

statement error
OPTIMIZE trucks MAXIMIZE SUM(prediction * plan) USING MODEL breakdown;
----
<REGEX>:.*'plan' is text.*

statement error
OPTIMIZE trucks MAXIMIZE SUM(prediction) USING MODEL nope;
----
<REGEX>:.*no model named 'nope'.*

statement error
OPTIMIZE trucks MAXIMIZE SUM(prediction);
----
<REGEX>:.*needs USING MODEL.*

statement ok
UPDATE trucks SET service_cost = NULL WHERE id = 7;

statement error
OPTIMIZE trucks MAXIMIZE SUM(prediction * 4200 - service_cost) USING MODEL breakdown;
----
<REGEX>:.*1 of 800 rows have no value for the objective: service_cost is NULL there.*

query I
SELECT count(*) > 0 FROM pql_exec('OPTIMIZE trucks WHERE service_cost IS NOT NULL MAXIMIZE SUM(prediction * 4200 - service_cost) USING MODEL breakdown');
----
true

# DuckDB's own EXPLAIN is still DuckDB's
statement ok
EXPLAIN SELECT 42;

# and a script mixing the two runs in order
statement ok
SELECT 1; OPTIMIZE trucks WHERE id < 10 MAXIMIZE SUM(prediction) SUBJECT TO COUNT(*) <= 1 USING MODEL breakdown; SELECT 2;

# ---------------------------------------------------------------------------
# ASSIGN: tasks on resources, in sequence, under one limit per resource

statement ok
CREATE TABLE crews AS SELECT * FROM (VALUES
  ('A', 'van',    40.0, -75.0, 20.0, TIMESTAMP '2026-03-02 06:00'),
  ('B', 'van',    41.0, -74.0, 16.0, TIMESTAMP '2026-03-02 08:00'),
  ('C', 'reefer', 40.5, -76.0, 24.0, TIMESTAMP '2026-03-02 06:00'),
  ('D', 'van',    39.5, -75.5, 12.0, TIMESTAMP '2026-03-02 10:00')) t(crew, kind, lat, lon, hours, free_from);

# Thirty past jobs carry the crew that did them and the margin made; six are open.
statement ok
CREATE TABLE jobs AS
SELECT i AS job_id,
       TIMESTAMP '2026-01-05' + INTERVAL (i * 2) DAY AS received_at,
       39.5 + ((i * 7) % 20) / 10.0 AS from_lat, -76.5 + ((i * 11) % 30) / 10.0 AS from_lon,
       39.5 + ((i * 13) % 20) / 10.0 AS to_lat,  -76.5 + ((i * 3) % 30) / 10.0 AS to_lon,
       60 + (i * 37) % 180 AS miles,
       400 + (i * 53) % 900 AS rate,
       CASE WHEN i % 5 = 0 THEN 'reefer' ELSE 'van' END AS kind,
       TIMESTAMP '2026-03-02 06:00' + INTERVAL ((i % 3) * 8) HOUR AS window_from,
       TIMESTAMP '2026-03-02 06:00' + INTERVAL ((i % 3) * 8 + 10) HOUR AS window_to,
       CASE WHEN i < 30 THEN (ARRAY['A','B','C','D','none'])[1 + i % 5] ELSE 'none' END AS crew,
       CASE WHEN i < 30 THEN
            CASE WHEN i % 5 = 4 THEN (400 + (i * 53) % 900) * 0.10
                 ELSE (400 + (i * 53) % 900) * (0.35 + 0.02 * (i % 5)) - (60 + (i * 37) % 180) * 0.8 END
       END AS margin,
       (i >= 30)::INT AS open
FROM range(36) t(i);

statement ok
TRAIN MODEL job_margin PREDICT jobs.margin FOR jobs AT received_at WHERE open = 0
  EXCLUDE (job_id, open) OPTIONS (epochs = 40, hidden = 16, seed = 1);

# The plan carries where each job sits and what the placement cost; a job on
# nothing has no sequence.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM pql_exec($$
  OPTIMIZE jobs WHERE open = 1 AT received_at
    ASSIGN crew OVER crews.crew ELSE 'none'
      ONLY IF resource.kind = kind OR (resource.kind = 'reefer' AND kind = 'van')
      SEQUENCE FROM resource.free_from
        START DISTANCE(resource.lat, resource.lon, from_lat, from_lon) / 40
        SETUP DISTANCE(prev.to_lat, prev.to_lon, from_lat, from_lon) / 40
        DURATION miles / 40 + 1
        WINDOW BETWEEN window_from AND window_to
    MAXIMIZE SUM(prediction - plan.setup * 60)
    SUBJECT TO SUM(plan.setup + plan.duration) PER crew <= resource.hours
    USING MODEL job_margin$$));
----
job_id	BIGINT
received_at	TIMESTAMP
crew	VARCHAR
prediction	DOUBLE
objective	DOUBLE
sequence	BIGINT
begin	TIMESTAMP
setup	DOUBLE
duration	DOUBLE

# Every job is in the plan; the reefer crew takes the two reefer-compatible
# jobs in order, each beginning inside its window, and the rest go to nothing.
query ITII
SELECT job_id, p.crew, sequence, (begin BETWEEN window_from AND window_to)::INT
FROM pql_exec($$
  OPTIMIZE jobs WHERE open = 1 AT received_at
    ASSIGN crew OVER crews.crew ELSE 'none'
      ONLY IF resource.kind = kind OR (resource.kind = 'reefer' AND kind = 'van')
      SEQUENCE FROM resource.free_from
        START DISTANCE(resource.lat, resource.lon, from_lat, from_lon) / 40
        SETUP DISTANCE(prev.to_lat, prev.to_lon, from_lat, from_lon) / 40
        DURATION miles / 40 + 1
        WINDOW BETWEEN window_from AND window_to
    MAXIMIZE SUM(prediction - plan.setup * 60)
    SUBJECT TO SUM(plan.setup + plan.duration) PER crew <= resource.hours
    USING MODEL job_margin$$) p JOIN jobs USING (job_id)
ORDER BY job_id;
----
30	C	0	1
31	none	NULL	NULL
32	none	NULL	NULL
33	C	1	1
34	none	NULL	NULL
35	none	NULL	NULL

# EXPLAIN reports each limit per resource, against that resource's own cap.
query TRR
SELECT measure, round(value, 1), round(bound, 1) FROM pql_exec($$
  EXPLAIN OPTIMIZE jobs WHERE open = 1 AT received_at
    ASSIGN crew OVER crews.crew ELSE 'none'
      ONLY IF resource.kind = kind OR (resource.kind = 'reefer' AND kind = 'van')
      SEQUENCE FROM resource.free_from
        START DISTANCE(resource.lat, resource.lon, from_lat, from_lon) / 40
        SETUP DISTANCE(prev.to_lat, prev.to_lon, from_lat, from_lon) / 40
        DURATION miles / 40 + 1
        WINDOW BETWEEN window_from AND window_to
    MAXIMIZE SUM(prediction - plan.setup * 60)
    SUBJECT TO SUM(plan.setup + plan.duration) PER crew <= resource.hours
    USING MODEL job_margin$$)
WHERE measure LIKE '%for%' OR measure = 'rows';
----
SUM(plan.setup + plan.duration) PER crew <= resource."hours" for 'A'	0.0	20.0
SUM(plan.setup + plan.duration) PER crew <= resource."hours" for 'B'	0.0	16.0
SUM(plan.setup + plan.duration) PER crew <= resource."hours" for 'C'	10.4	24.0
SUM(plan.setup + plan.duration) PER crew <= resource."hours" for 'D'	0.0	12.0
rows	6.0	NULL

# Without SEQUENCE it is an assignment under per-resource counts: one job per
# crew, the plan meets its bound.
query TRR
SELECT measure, round(value, 2), round(bound, 2) FROM pql_exec($$
  EXPLAIN OPTIMIZE jobs WHERE open = 1 AT received_at
    ASSIGN crew OVER crews.crew ELSE 'none' ONLY IF resource.kind = kind
    MAXIMIZE SUM(prediction) SUBJECT TO COUNT(*) PER crew <= 1 USING MODEL job_margin$$)
WHERE measure = 'objective' OR measure LIKE 'crew = %';
----
objective	1424.12	1424.12
crew = 'A'	0.00	NULL
crew = 'B'	1.00	NULL
crew = 'C'	1.00	NULL
crew = 'D'	1.00	NULL
crew = 'none'	3.00	NULL

# What ASSIGN refuses.
statement error
OPTIMIZE jobs WHERE open = 1 AT received_at ASSIGN crew OVER crews.crew MAXIMIZE SUM(prediction) SUBJECT TO COUNT(*) <= 2 USING MODEL job_margin;
----
every limit is per resource

statement error
OPTIMIZE jobs WHERE open = 1 AT received_at ASSIGN crew OVER crews.nope ELSE 'none' MAXIMIZE SUM(prediction) USING MODEL job_margin;
----
not a column of 'crews'

statement error
OPTIMIZE jobs WHERE open = 1 AT received_at ASSIGN crew OVER crews.crew ELSE 'A' MAXIMIZE SUM(prediction) USING MODEL job_margin;
----
also a key of 'crews'

statement error
OPTIMIZE jobs WHERE open = 1 AT received_at ASSIGN crew OVER crews.crew CHOOSE crew IN ('A') MAXIMIZE SUM(prediction) USING MODEL job_margin;
----
ASSIGN and CHOOSE both decide the lever

statement error
OPTIMIZE jobs WHERE open = 1 AT received_at CHOOSE crew IN ('A', 'B') MAXIMIZE SUM(prediction - plan.setup) USING MODEL job_margin;
----
exist only in an ASSIGN statement
